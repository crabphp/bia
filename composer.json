{
    "name": "crabphp/bia",
    "description": "A fast, resumable coding agent CLI built on the Crab engine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "crabphp/framework": "^0.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "bin": [
        "bin/bia"
    ],
    "autoload": {
        "psr-4": {
            "Bia\\": "src/Bia/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php -l bin/bia"
    }
}
